POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
DISPLAY_TOKEN=
TAVILY_API_KEY=
ALLOW_DEMO=false
SEARXNG_SECRET=
SEARXNG_URL=http://searxng:8080

# 逗号分隔的 SearXNG 引擎名，须与 infrastructure/searxng/settings.yml 中启用的引擎一致。
# 大陆网络建议 360search（Google/DuckDuckGo/Brave 不可达，百度触发验证码，Bing 返回空页）。
SEARXNG_ENGINES=360search
# 搜索时间过滤（day/month/year）。360search 不提供日期，会被过滤成 0 条；留空则不过滤。
SEARXNG_TIME_RANGE=

# DingTalk enterprise application robot: group delivery, explicit claim releases next item.
# 扫码登录复用 APP_KEY/APP_SECRET；APP_KEY+APP_SECRET 都配置后登录页自动出现扫码入口。
DINGTALK_ENABLED=false
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 扫码登录回调地址（必须与钉钉开放平台「登录与分享」登记的回调完全一致）。
# 留空时默认用站点自身地址 + /dingtalk，如 https://scout.example.com/dingtalk
DINGTALK_REDIRECT_URI=
DINGTALK_ROBOT_CODE=
DINGTALK_CONVERSATION_ID=
DINGTALK_GROUP_NAME=钉钉群

# Optional read-only Xiaohongshu connector (random internal authentication token).
XIAOHONGSHU_TOKEN=
XIAOHONGSHU_URL=http://xiaohongshu:18060

# 全来源商机审核；未配置时商机候选等待，不推送
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
